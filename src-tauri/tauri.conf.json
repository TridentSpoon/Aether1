{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether1 Platform",
  "version": "0.4.0",
  "identifier": "com.tridentspoon.aether1",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aether1 Platform // CYBERNETIC AI HUD",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
